# For hosting the bot 24/7 (Render, Railway, Fly.io, any VPS). Mount a persistent volume at /app/data.
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt requirements-extra.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-extra.txt
COPY . .
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "hc.channels.telegram_bot"]
