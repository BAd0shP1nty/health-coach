# Copy to .env and fill in. Never share or commit .env.

# Required: DeepSeek API key (platform.deepseek.com) - the coach's brain
DEEPSEEK_API_KEY=your_deepseek_key_here
# Required for Telegram: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional
# TELEGRAM_ALLOWED_IDS=12345678,87654321   # restrict who can use the bot (empty = anyone who finds it)
# AGENT_MODEL=deepseek-chat                # the chat/tool-calling model
# AGENT_DAILY_LIMIT=80                     # max messages per user per day (cost control)
# HC_TZ=Asia/Kolkata                       # time zone for "today" and check-ins
# WHISPER_MODEL=base                       # voice notes: base (fast) or small (better Hindi)
